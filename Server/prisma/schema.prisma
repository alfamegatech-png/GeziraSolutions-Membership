model lookup_ref {
  id          Int           @id @default(autoincrement())
  code        Int           @unique
  name        String
  member_type String
  price       Int
  members_ref members_ref[]

  @@schema("public") // Associate with the public schema
}

model lookup_section {
  id      Int       @id @default(autoincrement())
  code    Int       @unique
  name    String
  members members[]

  @@schema("public") // Associate with the public schema
}

model lookup_status {
  id         Int           @id @default(autoincrement())
  code       Int           @unique
  name       String
  tag        String
  membership memberships[]

