  @@schema("public") // Associate with the public schema
}

model lookup_sex {
  id          Int           @id @default(autoincrement())
  code        Int           @unique
  name        String
  members     members[]
  members_ref members_ref[]

  @@schema("public") // Associate with the public schema
}

model lookup_nationality {
  id      Int       @id @default(autoincrement())
  code    Int       @unique
  name    String
  members members[]

  @@schema("public") // Associate with the public schema
}

model lookup_marital_status {
  id      Int       @id @default(autoincrement())
  code    Int       @unique
  name    String
  members members[]

  @@schema("public") // Associate with the public schema
}

model lookup_religion {
  id      Int       @id @default(autoincrement())
  code    Int       @unique
  name    String
  members members[]

  @@schema("public") // Associate with the public schema
}
